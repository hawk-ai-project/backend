DATABASE_URL=mysql+pymysql://user:password@localhost:3306/hawk_ai
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Backend runs on the host. If it runs in Docker on hawk_minio_network, use minio:9000.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=hawk-backend
MINIO_SECRET_KEY=change-this-to-another-long-random-password
MINIO_BUCKET=hawk-ai
MINIO_SECURE=false
MAX_UPLOAD_SIZE_MB=20

# Remote GPU inference server
AI_SERVER_URL=http://192.168.0.102:8000
AI_SERVER_TIMEOUT_SECONDS=120
